# Notification system secrets
# Copy this file to .env and fill in values for your environment.
# .env is git-ignored — never commit actual secrets.
# Real environment variables (CI/CD, Docker) take precedence over values here.
#
# Non-sensitive settings (hosts, ports, names) stay in config.local.yaml.
# Only secrets and credentials go here.

# ── Postgres ──────────────────────────────────────────────
NOTIFY_POSTGRES_USER=notify
NOTIFY_POSTGRES_PASSWORD=notify

# ── RabbitMQ ──────────────────────────────────────────────
NOTIFY_RABBITMQ_USER=notify
NOTIFY_RABBITMQ_PASSWORD=notify
